{
  "manifestVersion": 1,
  "id": "radio-fm",
  "publisher": "jrmatos",
  "name": "Radio FM",
  "version": "1.0.0",
  "description": "Radio panel for Orca: Jovem Pan FM in 23 Brazilian cities plus other stations, easy to extend with radios from any country. Plays through mpv, ffplay or vlc.",
  "author": {
    "name": "Paulo Matos",
    "url": "https://github.com/jrmatos"
  },
  "repository": "https://github.com/jrmatos/orca-radio-fm",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "worker.mjs",
